[Unit]
Description=BestGAA operator dashboard (localhost only, token protected)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=@REPO_ROOT@
# The token is generated by ops/install_dashboard_secure.sh and kept in
# /etc/bestgaa/dashboard.env (root:ubuntu, mode 640). Never put it in Git.
# dashboard.env also carries BESTGAA_DIR (written by ops/install_dashboard_secure.sh):
# the bot directory whose .env, channels.json and database this page edits. Without
# it the dashboard fell back to its own checkout and showed another directory's
# (empty) database.
EnvironmentFile=/etc/bestgaa/dashboard.env
Environment=PYTHONUNBUFFERED=1
# localhost ONLY. This dashboard is reachable through an SSH tunnel, never
# from the public internet - do not change the host to 0.0.0.0.
Environment=DASHBOARD_HOST=127.0.0.1
Environment=DASHBOARD_PORT=8080
# The restart button goes through the approval gate: while POSTING_APPROVED is
# absent it refuses to restart anything, so a stray click cannot start posting.
Environment=DASHBOARD_RESTART_CMD=/usr/local/sbin/bestgaa-restart-gate
ExecStart=@PYTHON@ -m dashboard.app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@REPO_ROOT@
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
