# BestGAA Telegram -> WhatsApp bridge — environment template.
# Copy to `.env` next to bridge.js and fill the three REQUIRED values:
#   cp .env.example .env && chmod 600 .env
# Then pair once: `npm run pair` (code) or `npm run pair:qr`, and run with
# `npm start` (or tg-wa-bridge.service). Every knob below shows its default.

# --- REQUIRED: Telegram bot token that reads our channels ---
TELEGRAM_BOT_TOKEN=

# --- REQUIRED: WhatsApp account (digits only, country code first) ---
WA_PHONE=

# --- REQUIRED: main WhatsApp Channel (invite link or @newsletter JID) ---
WA_CHANNEL=

# --- Price-tier channels (empty = that tier stays off) ---
#WA_CHANNEL_UNDER99=
#WA_CHANNEL_UNDER499=
#WA_CHANNEL_BEST_OF=
# Set true to mirror EVERY post to both main channels instead of routing.
#WA_CHANNEL_ALL_POSTS=false

# --- Display shortening (optional) ---
# Comma-separated Bitly tokens; long links shorten after provenance + health
# checks. Empty = tokenless is.gd fallback, the deal still goes out.
#WA_BITLY_TOKENS=
#WA_SHORTEN_MIN_LEN=65

# --- Attribution (must match the bot side) ---
#AMAZON_TAG=mama086-21
#EARNKARO_PUBLISHER_ID=5478322
#HYPD_STORES=93944,smartdeals

# --- Read the bot's live DB for HYPD mappings + dedup state ---
#BESTGAA_DB_PATH=/home/ubuntu/bestgaa-bot/bestgaa-bot/bestgaa.sqlite3

# --- Best-deal quality gate (WhatsApp is curated, Telegram carries all) ---
#WA_BEST_GATE=true
#WA_BEST_MIN_DISCOUNT=30
#WA_BEST_MAX_PRICE=499
#WA_BEST_MIN_NAME_CHARS=6
#WA_QUALITY_MIN_SCORE=3
#WA_QUALITY_STRONG_DISCOUNT=70
#WA_QUALITY_EXPENSIVE_PRICE=1999
#WA_QUALITY_WEAK_DISCOUNT=40
#WA_UNDER99_MAX_PRICE=99

# --- Sources ---
# Our channels to mirror (comma list); direct-source safety net watches the
# raw deal sources too (empty value disables it - see bridge.js for default).
#TG_SOURCE_USERNAMES=Under99Deals11,under499loots,LootZoneIndia11,SecretLootIndia1,PowerLoots1,Premiumlootsdeals
#TG_DIRECT_SOURCES=
#WA_PRIMARY_SOURCE=under499loots
#WA_SECONDARY_SOURCE=under99deals11
#WA_PREFERRED_SOURCES=DealsUnder99_com
#WA_MEDIA_FIRST=true
#WA_PROMOTE_AFTER_MINUTES=45

# --- Pacing / quiet hours (IST) ---
# Caps are 0 = off by default; gaps in seconds.
#WA_DAY_CAP=0
#WA_HOUR_CAP=0
#MIN_WA_MESSAGE_GAP_SECONDS=30
#WA_MAX_MESSAGE_GAP_SECONDS=3600
#WA_INTER_TARGET_GAP_SECONDS=6
#QUIET_START=02:00
#QUIET_END=06:00

# --- Groups: OFF by default (channels only). To fan out to groups too, set
# WA_CHANNEL_ONLY=false and list group JIDs / invite links in WA_GROUPS.
#WA_CHANNEL_ONLY=true
#WA_GROUPS=

# --- Dead-link policy: false = cut the bad link, post the deal (default);
# true = refuse to post when a destination is dead.
#WA_DROP_DEAD_LINKS=false

# --- Logging ---
#LOG_LEVEL=info
