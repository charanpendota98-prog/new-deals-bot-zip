# BestGAA Telegram bot — environment template.
# Copy to `.env` next to main_bot_new.py and fill the three REQUIRED values:
#   cp .env.example .env && chmod 600 .env
# Everything else below already shows its built-in default; uncomment to tune.
# Core targets/sources/routing are pinned in main_bot_new.py. The six optional
# category mirror targets below are the only product-category destinations.

# --- REQUIRED: Telegram API credentials (https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- REQUIRED: EarnKaro/Affiliaters converter token ---
# A JWT from the Affiliaters/EarnKaro API page (payload carries the 'earnkaro'
# publisher id). Without it the bot posts untagged links = zero commission.
# Rotate with: bash ops/set_earnkaro_key.sh '<new-token>'
EARNKARO_API_KEY=

# --- Optional product-category Telegram mirrors ---
# Deals still go to the Main channel. A confident single-product match adds one
# category destination; mixed/unclear roundups stay Main-only. Create each
# Telegram channel first and make the Telethon session account an admin.
# Routing uses readable product terms in text and incoming/resolved URL paths or
# selected search queries; it does not inspect merchant-page HTML. Opaque IDs and
# mixed/unclear products stay Main-only. Use the channel username (with or
# without @); empty = that category is off.
#TG_CATEGORY_FOOTWEAR_TARGET=
#TG_CATEGORY_FASHION_TARGET=
#TG_CATEGORY_ELECTRONICS_TARGET=
#TG_CATEGORY_HOME_KITCHEN_TARGET=
#TG_CATEGORY_BEAUTY_TARGET=
#TG_CATEGORY_GROCERY_TARGET=
#TG_CATEGORY_ACCESSORIES_TARGET=
# fashion = clothing only; handbags/wallets/backpacks use accessories (rules v2).

# --- Amazon Associates (optional but earning) ---
# Must be one of OUR tags (today: mama086-21); anything else is ignored and the
# bot posts tagless. AMAZON_TAG_TARGETS=all tags core owned channels. New
# category channels are intentionally EXCLUDED until you declare them in
# Associates Central, then list their exact Telegram usernames below. Default
# tags the review channel only. See ops/AMAZON_APPLICATION_CHECKLIST.txt.
#AMAZON_TAG=mama086-21
#AMAZON_TAG_TARGETS=all
# Only after each new category channel is declared in Associates Central:
#AMAZON_TAG_CATEGORY_TARGETS=FootwearDeals,ElectronicsDeals
# Amazon order: native tagged link FIRST (whole commission ours), EarnKaro as
# the second chance when no usable ASIN exists. Both default true.
#AMAZON_DIRECT_ASSOCIATES=true
#AMAZON_VIA_EARNKARO=true
# EarnKaro publisher id is read from the TOKEN itself; this is only a fallback.
#EARNKARO_PUBLISHER_ID=

# --- Link shortening (optional) ---
# Comma-separated Bitly tokens; lists + long links shorten through them.
# Empty = tokenless is.gd fallback, the deal still goes out.
#BITLY_TOKENS=
#SHORTEN_MIN_LEN=70

# --- HYPD creator store (Meesho monetization) ---
# Our store id + slug; learned share links live in the DB (see ops/hypd_links.py).
#HYPD_STORE_ID=93944
#HYPD_STORE_SLUG=smartdeals

# --- Queue / workers ---
#QUEUE_WORKERS=8
#QUEUE_ORDER=newest
#JOB_MAX_ATTEMPTS=10
#POST_RETRIES=3
#MAX_JOB_AGE_HOURS=6

# --- Source rescan safety net (catches event-stream gaps) ---
#SOURCE_RESCAN_SECONDS=120
#SOURCE_RESCAN_LIMIT=40
#SOURCE_RESCAN_CONCURRENCY=4
#SOURCE_REFRESH_SECONDS=180

# --- Startup backfill (missed deals while the bot was down) ---
#BACKFILL_HOURS=6
#BACKFILL_LIMIT=50

# --- Dedup windows ---
#LINK_CACHE_DAYS=14
#PRICE_DEDUP_SECONDS=0

# --- Shopping channel window + cap ---
#SHOPPING_TARGET_ENABLED=true
#SHOPPING_DAILY_CAP=50
#SHOPPING_ACTIVE_START=8
#SHOPPING_ACTIVE_END=23

# --- Posting pace (0 = back-to-back, no artificial waiting) ---
#TARGET_FANOUT_GAP_MIN=0
#TARGET_FANOUT_GAP_MAX=0
#POST_QUIET_START=02:00
#POST_QUIET_END=06:00

# --- Local paths (deploy scripts / test gate override these) ---
#BOT_DB_PATH=bestgaa.sqlite3
#BOT_LOG_DIR=logs
#BOT_MEDIA_DIR=media
#TELEGRAM_SESSION=bestgaa_fresh

# --- Advanced: link attribution (see code comments before touching) ---
# Stores where ?affExtParam2=<publisher> is the converter's own native shape.
# Add a host only when the converter really mints that shape on it (shopsy.in
# was added 2026-10-19 from a real link the user pasted).
#EK_ATTRIBUTION_HOSTS=flipkart.com,shopsy.in,myntra.com
#ATTRIBUTE_PASSTHROUGH_LINKS=true

# --- Advanced: link-health budgets (see code comments before touching) ---
#PRESEND_CHECK_BUDGET_SECONDS=6
#PRESEND_FRESH_SECONDS=30
# How many times every link is re-verified (ours? alive?) immediately before the
# post leaves. The happy path costs ONE pass; the passes only repeat while a link
# is still answering an outage/dead page.
#POST_VERIFY_ATTEMPTS=10
#POST_VERIFY_SLEEP_SECONDS=2
#LINK_PROBE_BUDGET_SECONDS=3.5
#LINK_HEALTH_CACHE_SECONDS=900
#LINK_OUTAGE_CACHE_SECONDS=45
#LINK_CHECK_ATTEMPTS=2
#LINK_CHECK_RETRY_SLEEP_SECONDS=0.4
#HTTP_TOTAL_TIMEOUT_SECONDS=12
#MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
#MAX_MEDIA_MB=45
#MAX_ALBUM_PHOTOS=10
